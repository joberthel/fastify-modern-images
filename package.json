{
  "name": "fastify-modern-images",
  "version": "0.7.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Fastify plugin, which converts images automatically into modern formats.",
  "author": "Johannes Berthel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joberthel/fastify-modern-images.git"
  },
  "keywords": [
    "fastify",
    "webp",
    "avif",
    "jpeg",
    "png",
    "image tranformation"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "dev": "tsc-watch --onSuccess \"node example/server.js\"",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.1",
    "lodash": "^4.17.21",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@fastify/static": "^8.1.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fastify": "^5.2.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.2.2",
    "vitest": "^5.1.0"
  }
}
