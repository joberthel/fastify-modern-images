{
  "name": "fastify-modern-images",
  "type": "commonjs",
  "version": "0.8.2",
  "packageManager": "pnpm@12.18.0",
  "description": "Fastify plugin, which converts images automatically into modern formats.",
  "author": "Johannes Berthel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joberthel/fastify-modern-images.git"
  },
  "keywords": [
    "fastify",
    "webp",
    "avif",
    "jpeg",
    "png",
    "image transformation"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "dev": "tsc-watch --onSuccess \"node example/server.js\"",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run test/ --coverage",
    "test:diff-cover": "diff-cover coverage/lcov.info --compare-branch=origin/main --fail-under=100 --show-uncovered",
    "test:e2e": "vitest run e2e/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:pkg": "publint && attw --pack .",
    "commitlint": "commitlint"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@fastify/static": "^10.1.11",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "diff-cover": "^2.0.5",
    "eslint": "^10.14.0",
    "fastify": "^5.12.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "publint": "^0.3.25",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
